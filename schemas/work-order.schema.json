{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:claude-ams:schema:work-order:1",
  "title": "Claude AMS work order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workOrderId",
    "rootObjectiveId",
    "logicalParent",
    "role",
    "delegationAuthority",
    "backend",
    "requestedRoute",
    "modelCeiling",
    "objective",
    "acceptanceCriteria",
    "scope",
    "excludedScope",
    "dependencies",
    "writeOwnership",
    "requiredValidation",
    "deviationTriggers",
    "returnContract"
  ],
  "properties": {
    "workOrderId": { "type": "string", "pattern": "^WO-[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "rootObjectiveId": { "type": "string", "pattern": "^OBJ-[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "logicalParent": { "type": "string", "minLength": 1, "maxLength": 128 },
    "role": { "enum": ["worker", "delegated-manager"] },
    "delegationAuthority": { "enum": ["none", "request"] },
    "backend": { "enum": ["direct", "nested", "team", "workflow"] },
    "requestedRoute": { "enum": ["haiku", "sonnet", "opus", "inherit"] },
    "modelCeiling": { "enum": ["haiku", "sonnet", "opus", "inherit"] },
    "objective": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStrings" },
    "scope": { "$ref": "#/$defs/nonEmptyStrings" },
    "excludedScope": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "authoritativeContext": { "type": "array", "items": { "type": "string" } },
    "readOwnership": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "writeOwnership": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "isolation": { "enum": ["shared-readonly", "shared-serialized", "worktree"] },
    "gitAuthority": { "enum": ["none", "inspect", "commit-own-work", "integrate"] },
    "allowedTools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "maximumTurns": { "type": "integer", "minimum": 1, "maximum": 200 },
    "descendantAllocation": { "type": "integer", "minimum": 0, "maximum": 200 },
    "delegableScope": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "requiredActions": { "type": "array", "items": { "type": "string" } },
    "requiredValidation": { "$ref": "#/$defs/nonEmptyStrings" },
    "deviationTriggers": { "$ref": "#/$defs/nonEmptyStrings" },
    "returnContract": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "worker" } } },
      "then": {
        "properties": {
          "delegationAuthority": { "const": "none" },
          "descendantAllocation": { "const": 0 }
        }
      }
    },
    {
      "if": { "properties": { "role": { "const": "delegated-manager" } } },
      "then": {
        "properties": { "delegationAuthority": { "const": "request" } },
        "required": ["descendantAllocation", "delegableScope"]
      }
    }
  ]
}
